# Copy to .env and replace every placeholder before starting the stack.
GITHUB_PERSONAL_ACCESS_TOKEN=replace_with_github_personal_access_token
GOOGLE_API_KEY=replace_with_google_gemini_api_key
# Default Store 1 WordPress service (adjust to `minikube ip` and its HTTP NodePort if needed).
WOOCOMMERCE_URL=http://127.0.0.1:38081
# Backend address on the Minikube Docker network; must differ from the node IP.
MINIKUBE_BACKEND_IP=192.168.49.254
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
POSTGRES_DB=kube_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_unique_database_password

# Generate with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=replace_with_base64_encoded_32_random_bytes
JWT_EXPIRATION_SECONDS=900

# Team invitations. For Gmail use smtp.gmail.com:587 and a Google App Password
# (not your normal account password); use the provider-specific SMTP values otherwise.
TEAM_INVITATION_EXPIRATION_HOURS=72
TEAM_INVITATION_DEV_LINKS_ENABLED=false
INVITATION_FRONTEND_BASE_URL=http://localhost:5173
TEAM_INVITATION_EMAIL_ENABLED=false
# Set TEAM_INVITATION_EMAIL_ENABLED=true after supplying valid SMTP settings.
TEAM_INVITATION_FROM=your-verified-sender@example.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-verified-sender@example.com
SPRING_MAIL_PASSWORD=your-provider-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
SPRING_PROFILES_ACTIVE=

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
# Optional initial member. Set both fields or leave both empty.
INITIAL_MEMBER_USERNAME=
INITIAL_MEMBER_PASSWORD=

DASHBOARD_ALLOWED_ORIGIN=http://localhost:5173
